# Layout Orchestrator — Environment Configuration
# Copy this file to .env and fill in values for your setup.

# ─── HTTP Server ──────────────────────────────────────────────────────────────
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# ─── MQTT Broker ──────────────────────────────────────────────────────────────
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=layout-orchestrator
# MQTT_USERNAME=
# MQTT_PASSWORD=

# ─── DCC Serial Controller ────────────────────────────────────────────────────
DCC_SERIAL_PORT=/dev/ttyUSB0
DCC_BAUD_RATE=115200

# ─── Simulator / Hardware Mode ────────────────────────────────────────────────
#
#  USE_SIMULATOR=true,  DCC_SIMULATOR=any   → Full simulator (no broker, no hardware)
#  USE_SIMULATOR=false, DCC_SIMULATOR=true  → Hybrid: real MQTT broker + simulated DCC
#  USE_SIMULATOR=false, DCC_SIMULATOR=false → Full hardware: real broker + DCC EX serial
#
# Set USE_SIMULATOR=true only when you want to run with no broker and no hardware at all.
USE_SIMULATOR=false
DCC_SIMULATOR=true

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/layout.db
# Path to the Drizzle migration files. Migrations are applied automatically on startup.
MIGRATIONS_PATH=./migrations

# ─── Authentication (see docs/auth.md) ────────────────────────────────────────
#
# Required on first run only: if the `users` table is empty on startup, this
# password bootstraps a single admin account (username "admin") and the
# backend refuses to start without it — a fresh deployment with no accounts
# and no way to log in is a permanent lockout. Ignored once any user exists;
# an operator who has since changed the admin account is never overridden by
# a stale value left here. Forgot the password instead? Reset it with:
#   npm run bootstrap-admin --workspace=packages/backend -- <username> <password>
INITIAL_ADMIN_PASSWORD=change-me-before-first-run

# Comma-separated list of origins allowed to make credentialed requests to
# the API (CORS). The frontend dev server's default origin is listed below;
# add the production frontend's https:// origin here once TLS is in place.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Must stay `false` until TLS is in place — a `Secure` cookie sent over plain
# HTTP is silently refused by the browser, which would make every session
# fail closed. Set to `true` once the backend is served over https://.
COOKIE_SECURE=false

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
